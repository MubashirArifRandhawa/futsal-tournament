rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // An admin is a signed-in user whose UID has a document in /admins.
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Admin list: a user may only check their own entry. Add admins in the
    // Firebase console (never from the website).
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Site settings (which tournament is featured)
    match /config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Tournaments, their teams and matches: everyone can read, admins write.
    match /tournaments/{tid} {
      allow read: if true;
      allow write: if isAdmin();

      match /teams/{teamId} {
        allow read: if true;
        allow write: if isAdmin();
      }
      match /matches/{matchId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }
  }
}
